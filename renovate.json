{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "enabledManagers": ["github-actions", "dockerfile", "custom.regex"],
  "ignoreDeps": ["imagemagick"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libjpeg_turbo\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "libjpeg-turbo/libjpeg-turbo",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libpng\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "https://github.com/glennrp/libpng",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libtiff\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "libtiff/libtiff",
      "datasourceTemplate": "gitlab-releases",
      "registryUrlTemplate": "https://gitlab.com",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"lcms2\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "mm2/Little-CMS",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^lcms(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libwebp\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "https://github.com/webmproject/libwebp",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libaom\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "https://aomedia.googlesource.com/aom",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libde265\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "strukturag/libde265",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libheif\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "strukturag/libheif",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^libraries\\.json$/"
      ],
      "matchStrings": ["\"key\":\\s*\"libraw\"[\\s\\S]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "LibRaw/LibRaw",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Ubuntu versions in test-installer.yml are intentional test matrix entries (test targets), not dependency updates",
      "matchFileNames": [".github/workflows/test-installer.yml"],
      "enabled": false,
      "matchDepNames": [
        "/^ubuntu/"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "bundled libraries"
    },
    {
      "description": "Bundled libraries: safety net for the loose-versioned deps (lcms2, LibRaw) whose parser never flags pre-releases — skip alpha/beta/rc/pre tags. semver-versioned deps are already covered by ignoreUnstable",
      "matchManagers": ["custom.regex"],
      "allowedVersions": "!/alpha|beta|rc|pre/i"
    },
    {
      "description": "LibRaw tags beta releases with a trailing letter (e.g. 0.21.5b) — only track plain X.Y.Z stable tags",
      "matchDepNames": ["LibRaw/LibRaw"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    }
  ]
}
